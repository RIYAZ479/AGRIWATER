FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Default SQLite database for instant development, easily points to MySQL:
# mysql+pymysql://<user>:<password>@localhost:3306/agriwater_db
DATABASE_URL=sqlite:///agriwater.db

DEFAULT_TANK_DEPTH_CM=100.0
TOTAL_TANK_CAPACITY_L=10000.0
SERIAL_BAUD_RATE=9600
