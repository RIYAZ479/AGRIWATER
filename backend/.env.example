# Flask Environment Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=your_secret_key_here_replace_in_production

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agriwater_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Database URL
# Default SQLite fallback for immediate testing without local MySQL installation:
DATABASE_URL=sqlite:///agriwater.db

# Live MySQL Connection String format:
# DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# Sensor Hardware Settings
# The Arduino sketch currently declares a 30 cm tank; replace with installation measurements.
DEFAULT_TANK_DEPTH_CM=30.0
# Optional per-tank overrides (replace these example values with measurements).
# Example: TANK_DEPTHS_CM=1:30.0,2:85.0
TANK_DEPTHS_CM=
HC_SR04_MIN_DISTANCE_CM=2.0
HC_SR04_MAX_DISTANCE_CM=400.0
TOTAL_TANK_CAPACITY_L=10000.0
SERIAL_BAUD_RATE=9600

# OpenWeatherMap API Key (Optional)
OPENWEATHER_API_KEY=
